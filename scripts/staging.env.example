# staging.env — sample env for local Docker run.
# DO NOT commit real values. Generate fresh throwaway secrets locally.
#
# Rules:
#   * APP_ENV MUST be staging (or production) for real deploys — this
#     enables the DOWNLOAD_SECRET fail-loud check.
#   * DOWNLOAD_SECRET MUST be provided as long-lived value (not random
#     per boot) so tokens survive replica restarts. Generate with:
#       openssl rand -hex 32
#   * ADMIN_STATS_TOKEN MUST be a fresh value distinct from anything
#     used in production. Never reuse a prod secret in staging.
#   * CORS_EXTRA_ORIGINS should list ONLY the Deploy Preview URL the
#     staging service is meant to serve; keep production origins out.
#   * USE_ADOBE should remain unset in staging so pdf2docx / pdfplumber
#     handle conversions — avoids spending Adobe quota on test traffic.

APP_ENV=staging
DOWNLOAD_SECRET=change-me-to-a-fresh-openssl-rand-hex-32-value
ADMIN_STATS_TOKEN=change-me-to-a-fresh-openssl-rand-hex-32-value
CORS_EXTRA_ORIGINS=https://deploy-preview-1--pdfmasry-staging.netlify.app
ADOBE_MONTHLY_QUOTA=500

# Uncomment to route conversions through Adobe SDK instead of pdf2docx
# (requires ADOBE_CLIENT_ID / ADOBE_CLIENT_SECRET).
# USE_ADOBE=false
